<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sketchly: Draw with AI Feedback</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Required Device Capabilities -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- Launch Screen -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- Camera Permission -->
	<key>NSCameraUsageDescription</key>
	<string>Sketchly needs camera access to photograph your drawings for AI-powered critique and feedback.</string>

	<!-- Photo Library Permission -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sketchly needs access to your photo library to import drawings for AI critique.</string>

	<!-- App Tracking Transparency -->
	<key>NSUserTrackingUsageDescription</key>
	<string>This identifier will be used to deliver personalized content and ads to you.</string>

	<!-- Facebook SDK Configuration -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb1234567890</string>
			</array>
		</dict>
	</array>
	<key>FacebookAppID</key>
	<string>1234567890</string>
	<key>FacebookClientToken</key>
	<string>PLACEHOLDER_CLIENT_TOKEN</string>
	<key>FacebookDisplayName</key>
	<string>Sketchly</string>

	<!-- SKAdNetwork Items for Attribution -->
	<key>SKAdNetworkItems</key>
	<array>
		<!-- Meta (Facebook) SKAdNetwork IDs -->
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>v9wttpbfk9.skadnetwork</string>
		</dict>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>n38lu8286q.skadnetwork</string>
		</dict>
		<!-- TikTok SKAdNetwork IDs -->
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>238da6jt44.skadnetwork</string>
		</dict>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>22mmun2rn5.skadnetwork</string>
		</dict>
	</array>

	<!-- App supports file sharing -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
